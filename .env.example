# Copy once to .env per developer or integration host. Never commit .env.
# Use distinct strong passwords for each service. Changing them after DB first initialization
# does NOT update existing PostgreSQL roles; handle password rotation separately.
POSTGRES_PASSWORD=REPLACE_STRONG_POSTGRES_PASSWORD
MEMBER_DB_PASSWORD=REPLACE_STRONG_MEMBER_PASSWORD
ASSET_DB_PASSWORD=REPLACE_STRONG_ASSET_PASSWORD
WORKORDER_DB_PASSWORD=REPLACE_STRONG_WORKORDER_PASSWORD
INVENTORY_DB_PASSWORD=REPLACE_STRONG_INVENTORY_PASSWORD
AI_DB_PASSWORD=REPLACE_STRONG_AI_PASSWORD
# Local developers: 127.0.0.1; leader shared DB: explicitly use leader LAN IP and firewall allowlist.
DB_BIND_IP=127.0.0.1
DB_PORT=5432
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
DEMO_EMAIL_VERIFICATION_BYPASS=false
DEMO_BUILDING_APPROVAL_BYPASS=false
