# Copy once to .env per developer/integration host. Never commit .env.
# Changing passwords after DB initialization does not update existing PostgreSQL roles.
POSTGRES_PASSWORD=REPLACE_STRONG_POSTGRES_PASSWORD
MEMBER_DB_PASSWORD=REPLACE_STRONG_MEMBER_PASSWORD
ASSET_DB_PASSWORD=REPLACE_STRONG_ASSET_PASSWORD
WORKORDER_DB_PASSWORD=REPLACE_STRONG_WORKORDER_PASSWORD
INVENTORY_DB_PASSWORD=REPLACE_STRONG_INVENTORY_PASSWORD
AI_DB_PASSWORD=REPLACE_STRONG_AI_PASSWORD

# Local: 127.0.0.1; shared DB: use explicitly allowed LAN IP and firewall rules.
DB_BIND_IP=127.0.0.1
DB_PORT=5432
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# AI model provider configuration (set real key only in untracked .env or a secret manager)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Redis private session state
REDIS_BIND_IP=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Refresh Cookie configuration
AUTH_COOKIE_SECURE=false

AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://127.0.0.1:5173,http://127.0.0.1:8088
# Roster: independent Base64-encoded 32-byte keys; keep stable and private.
ROSTER_ENCRYPTION_KEY=
ROSTER_LOOKUP_KEY=

# Verification delivery (disabled by default; mock requires demo-only profile)
VERIFICATION_PROVIDER=disabled
# Per-channel overrides: email smtp/mock/webhook/disabled; SMS mock/webhook/disabled.
VERIFICATION_EMAIL_PROVIDER=disabled
VERIFICATION_SMS_PROVIDER=disabled
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Optional public frontend origin for organization invitation emails (no path).
FIXOPS_PUBLIC_URL=
VERIFICATION_HASH_KEY=
VERIFICATION_ENDPOINT=
VERIFICATION_SECRET=
VERIFICATION_DEMO_EMAILS=
VERIFICATION_DEMO_PHONES=

# Member-to-Asset internal credential; independent random 32-byte Base64 key.
MEMBER_UNIT_INTERNAL_KEY=
MEMBER_SPRING_PROFILES_ACTIVE=default

# Decoded public data portal service key (not URL-encoded).
KAPT_SERVICE_KEY=
# Building register API approval required; blank uses KAPT_SERVICE_KEY in Docker.
BUILDING_REGISTER_SERVICE_KEY=
# Opt-in background catalog synchronization; verify public API quota first.
KAPT_CATALOG_SYNC_ENABLED=false

# Independent per-service credentials for Member authorization checks (32-byte random Base64).
ASSET_AUTHZ_KEY=
WORKORDER_AUTHZ_KEY=
INVENTORY_AUTHZ_KEY=
AI_AUTHZ_KEY=
